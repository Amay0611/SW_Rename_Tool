<Window x:Class="SwRenameTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SolidWorks リネームツール" Height="750" Width="1350"
        FontSize="14">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 上部: アセンブリ選択 -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <Button Content="アセンブリを選択" Click="OnSelectAssemblyClick" Padding="8,4"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
            <TextBlock Text="{Binding SelectedAssemblyPath}" VerticalAlignment="Center" Margin="8,0" />
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="16,0"
                       Foreground="Gray" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 中段: 一覧 ＋ 拡大プレビュー -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- 一覧: サムネイル/変更前/変更後/参照元/状態 -->
            <DataGrid Grid.Column="0" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                      IsReadOnly="False" CanUserAddRows="False"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      RowHeight="36">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Resources>
                    <Style x:Key="CenteredCellText" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="サムネイル" Width="70" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Thumbnail}"
                                       Stretch="Uniform" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="種別" Binding="{Binding FileTypeDisplay}" Width="48" IsReadOnly="True"
                                         ElementStyle="{StaticResource CenteredCellText}" />
                    <DataGridTemplateColumn Header="変更前" Width="1.5*" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FileName}" Margin="{Binding IndentMargin}"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="変更後" Binding="{Binding NewBaseName, UpdateSourceTrigger=PropertyChanged}"
                                         Width="1.5*" ElementStyle="{StaticResource CenteredCellText}">
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="参照" Binding="{Binding ReferenceCount}" Width="48" IsReadOnly="True"
                                         ElementStyle="{StaticResource CenteredCellText}" />
                    <DataGridTextColumn Header="備考" Binding="{Binding ExclusionReason}" Width="150" IsReadOnly="True"
                                         ElementStyle="{StaticResource CenteredCellText}" />
                    <DataGridCheckBoxColumn Header="連動" Binding="{Binding IsNameSyncLocked}" Width="48">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                        <DataGridCheckBoxColumn.EditingElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridCheckBoxColumn.EditingElementStyle>
                    </DataGridCheckBoxColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 拡大プレビューパネル -->
            <Border Grid.Column="1" Margin="8,0,0,0" Padding="12" Background="#F5F5F5"
                    BorderBrush="#DDDDDD" BorderThickness="1" TextElement.FontSize="16">
                <StackPanel>
                    <Border Width="270" Height="270" Background="White"
                            BorderBrush="#DDDDDD" BorderThickness="1" HorizontalAlignment="Center">
                        <Image Source="{Binding SelectedRow.LargeThumbnail}" Stretch="Uniform" Margin="4" />
                    </Border>
                    <TextBlock Text="{Binding SelectedRow.FileName}" FontWeight="Bold"
                               Margin="0,10,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="拡大プレビュー" Foreground="Gray" Margin="0,2,0,0" />

                    <Border BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Margin="0,10,0,10" />

                    <TextBlock Text="参照元アセンブリ" Foreground="Gray" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding SelectedRow.Node.Parents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FileName}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Dry Run結果 -->
        <Expander Grid.Row="2" Header="Dry Run 結果" Margin="0,8,0,0"
                  IsExpanded="{Binding DryRunResult, Converter={StaticResource NotNullConverter}, Mode=OneWay}"
                  Visibility="{Binding DryRunMessages.Count, Converter={StaticResource CountToVisibilityConverter}}">
            <ListBox ItemsSource="{Binding DryRunMessages}" MaxHeight="140" />
        </Expander>

        <!-- 下部: 実行系ボタン -->
        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,8,0,0">
            <Button Content="Dry Run 実行" Command="{Binding RunDryRunCommand}" Padding="8,4" />
            <Button Content="バックアップ&amp;実行" Command="{Binding ExecuteCommand}" Padding="8,4" Margin="8,0,0,0" />
            <Button Content="キャンセル（実行前まで有効）" Command="{Binding CancelExecutionCommand}" Padding="8,4" Margin="8,0,0,0" />
            <ProgressBar Value="{Binding ExecutionProgress}" Width="200" Height="16" Margin="16,0,0,0"
                         VerticalAlignment="Center" />
            <TextBlock Text="{Binding CurrentProcessingFileName}" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
