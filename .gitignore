## ---------------------------------------------------------------
## このプロジェクト固有
## ---------------------------------------------------------------

# SolidWorks Interopアセンブリ（ライセンス上リポジトリに含めない。
# 各自のSolidWorksインストールフォルダからthirdparty/README.txtの手順でコピーする）
thirdparty/*.dll

# 検証・テストで使ったSolidWorksファイル一式やバックアップフォルダを誤って
# 含めないためのガード（テスト用データを別リポジトリ・別フォルダで管理する場合）
_backup/
*.sldprt
*.SLDPRT
*.sldasm
*.SLDASM
*.slddrw
*.SLDDRW
# 上記でリポジトリに含めたいサンプル/テストデータがある場合は、
# 個別に ! (否定パターン) で明示的に許可してください。
# 例: !samples/**/*.SLDPRT

# SolidWorksが開いている間に生成されるロックファイル
~$*.sld*

# リネーム実行時のログ・バックアップ
rename_log_*.csv
